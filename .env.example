# Copy this file to `.env.local` (git-ignored) and fill in ONE of the options below.

# Recommended: URL of your TMDB proxy (see worker/ and the README).
# The API key stays on the proxy and never reaches the browser.
REACT_APP_TMDB_PROXY_URL=

# Local development only: call TMDB directly with your key.
# Never use this for a deployed build - the key is embedded in the public JavaScript.
REACT_APP_API_KEY=
